// Shared primitives and the vertical metrics of the panel card.
//
// Every `Metrics` value is a CSS box-model height measured from the shipped
// DOM (spike/slint-demo/ref/rects-*.json) and re-checked by
// `spike/p2/heights_ref.py`: the panes stack blocks with these exact heights,
// and `panel.slint` derives the card height from the same constants, so the
// layout and the number the window is sized to cannot drift apart.
import { Tokens } from "tokens.slint";

export global Metrics {
    // Card chrome, measured from the content box (inside the card's 1px
    // border): header + provider tab end at 87.5; the footer (hairline included)
    // is 53 tall. The card itself is content + 2 borders.
    out property <length> chrome-top: 87.5px;
    out property <length> chrome-bottom: 53px;
    // Transparent shadow fade room per side (PLAN §3.2).
    out property <length> margin: 28px;

    // Kimi pane blocks.
    out property <length> quota-block: 115px;      // .field 105 + .quota margin 10
    out property <length> cache-block: 116px;      // hair 1 + .field 105 + margin 10
    out property <length> decode-row: 56.5px;      // 1 + 9 + 17.5 + 6 + 14 + 9
    out property <length> extra-row: 36.5px;       // 1 + 9 + 17.5 + 9
    out property <length> extra-monthly: 33px;     // .extra-meta bar margin 9 + bar 4 + note 6 + 14
    out property <length> version-row: 37.5px;     // 1 + 9 + 17.5 + 10 (last-child pad)

    // DeepSeek pane blocks.
    out property <length> balance-block: 64.5px;   // 2 + 15 + 6 + 31.5 + 10
    out property <length> balance-detail: 21px;    // note margin 7 + 14
    out property <length> model-row: 71px;         // 9 + 20 + 8 + 3 + 7 + 14 + 9 + hair
    out property <length> last-model-row: 70px;    // last row draws no bottom hairline
    out property <length> summary-row: 33px;       // 1 + 8 + 14 + 10
    out property <length> hint-row: 37.5px;        // 1 + 10 + 16.5 + 10 (single line)
}

// A Text with a fixed CSS line box. Chrome lays `line-height: normal` out as an
// integer box (13px -> 17px, 12.5px -> 16px, ...) and centres the font's content
// box inside it (half-leading, negative for the 30px/1.05 number). Centring the
// glyphs in the same box reproduces that, including the negative case.
export component Txt inherits Text {
    in property <length> box: 17px;
    height: box;
    vertical-alignment: center;
    wrap: no-wrap;
    overflow: elide;
}

// 10/500, uppercase, .08em tracking — .label in theme.css
export component Lbl inherits Txt {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.8px;
    color: Tokens.ink2;
    box: 12px;
}

// 10.5/400 ink-2 — .note
export component Note inherits Txt {
    font-size: 10.5px;
    color: Tokens.ink2;
    box: 14px;
}

// Wrapping hint (.hint, 11/400, line-height 1.5). Kept apart from `Txt`, which
// is single-line and elides.
export component HintText inherits Text {
    font-size: 11px;
    // CSS line-height 1.5 = 16.5px. Slint has no line-height, so the one-line
    // box is explicit and the glyphs are centred in it.
    height: 16.5px;
    vertical-alignment: center;
    wrap: word-wrap;
    color: Tokens.ink2;
}

// 4px capsule track + fill — .bar
export component Bar inherits Rectangle {
    in property <float> pct: 0;
    in property <length> bar-height: 4px;
    height: bar-height;
    border-radius: 2px;
    background: Tokens.hair-soft;
    Rectangle {
        // Slint centres an un-positioned child in its parent; CSS anchors the
        // fill at the track's left edge.
        x: 0;
        y: 0;
        width: parent.width * min(1, pct / 100);
        height: 100%;
        border-radius: parent.border-radius;
        background: Tokens.accent-bar;
    }
}

// One cell of the shared .seg control: 30 high, radius 8, accent ring when on.
export component SegCell inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    border-radius: 8px;
    background: on ? Tokens.seg-on : transparent;
    border-width: on ? 1px : 0px;
    border-color: Tokens.seg-ring;
    Text {
        width: 100%;
        height: 100%;
        text: label;
        font-size: 12.5px;
        font-weight: on ? 500 : 400;
        color: on ? Tokens.ink1 : Tokens.ink2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 1px hairline drawn at a block's top edge.
export component Hair inherits Rectangle {
    height: 1px;
    background: Tokens.hair;
}

// The card shell every window paints on the transparent window: paper fill,
// 1px hairline, 12px radius and the CSS shadow (`0 8px 18px`, PLAN §3.2). The
// caller owns x/y/width/height — the settings sheet is content-sized in Rust,
// the menu is content-sized from its five rows.
export component CardBg inherits Rectangle {
    background: Tokens.paper;
    border-width: 1px;
    border-color: Tokens.hair;
    border-radius: 12px;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 8px;
    drop-shadow-blur: 18px;
    drop-shadow-spread: 0px;
    drop-shadow-color: Tokens.shadow;
}

// Ghost button (.btn): 34 high, hairline ring, 11.5/500, hover fill.
export component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    border-width: 1px;
    border-color: Tokens.hair;
    border-radius: 8px;
    background: (ta.has-hover && enabled) ? Tokens.seg-track : transparent;
    ta := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Text {
        width: 100%;
        height: 100%;
        text: label;
        font-size: 11.5px;
        font-weight: 500;
        color: enabled ? Tokens.ink1 : Tokens.ink2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The shared .seg control at the settings sheet's 318px content width. The
// active cell is ringed with the accent; the fill alone is under WCAG 3:1
// (theme.css `--seg-ring`). Cell geometry comes from the measured DOM:
// 3 cells 102.66 wide, 4 cells 76.5, 2px gaps, 3px track padding.
component SegBase inherits Rectangle {
    height: 36px;
    border-radius: 12px;
    background: Tokens.seg-track;
}

export component Seg3 inherits SegBase {
    in property <string> a;
    in property <string> b;
    in property <string> c;
    in property <int> selected: 0;
    callback pick(int);
    SegCell { x: 3px; y: 3px; width: 102.66px; height: 30px; label: a; on: selected == 0; }
    SegCell { x: 107.66px; y: 3px; width: 102.66px; height: 30px; label: b; on: selected == 1; }
    SegCell { x: 212.33px; y: 3px; width: 102.66px; height: 30px; label: c; on: selected == 2; }
    TouchArea { x: 3px; y: 3px; width: 102.66px; height: 30px; clicked => { pick(0); } }
    TouchArea { x: 107.66px; y: 3px; width: 102.66px; height: 30px; clicked => { pick(1); } }
    TouchArea { x: 212.33px; y: 3px; width: 102.66px; height: 30px; clicked => { pick(2); } }
}

export component Seg4 inherits SegBase {
    in property <string> a;
    in property <string> b;
    in property <string> c;
    in property <string> d;
    in property <int> selected: 0;
    callback pick(int);
    SegCell { x: 3px; y: 3px; width: 76.5px; height: 30px; label: a; on: selected == 0; }
    SegCell { x: 81.5px; y: 3px; width: 76.5px; height: 30px; label: b; on: selected == 1; }
    SegCell { x: 160px; y: 3px; width: 76.5px; height: 30px; label: c; on: selected == 2; }
    SegCell { x: 238.5px; y: 3px; width: 76.5px; height: 30px; label: d; on: selected == 3; }
    TouchArea { x: 3px; y: 3px; width: 76.5px; height: 30px; clicked => { pick(0); } }
    TouchArea { x: 81.5px; y: 3px; width: 76.5px; height: 30px; clicked => { pick(1); } }
    TouchArea { x: 160px; y: 3px; width: 76.5px; height: 30px; clicked => { pick(2); } }
    TouchArea { x: 238.5px; y: 3px; width: 76.5px; height: 30px; clicked => { pick(3); } }
}

// Title-bar close (.chrome-close): 22x22, radius 6, hover fill.
export component ChromeClose inherits Rectangle {
    callback close();
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: ta.has-hover ? Tokens.seg-track : transparent;
    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.close(); }
    }
    // The cross is drawn, not typed: U+2715 (what the markup uses) has no
    // glyph in Segoe UI and Skia renders a tofu box — WebView2 falls back to a
    // symbol font, Slint does not.
    Path {
        x: 7.5px;
        y: 7.5px;
        width: 7px;
        height: 7px;
        viewbox-width: 7;
        viewbox-height: 7;
        commands: "M0 0 L7 7 M7 0 L0 7";
        fill: transparent;
        stroke: ta.has-hover ? Tokens.ink1 : Tokens.ink2;
        stroke-width: 1.1px;
    }
}

// Title bar of the settings / skills windows: 34 high, wordmark + close, the
// whole row drags the window (the close button sits above and eats its own
// clicks).
export component TitleBar inherits Rectangle {
    in property <string> title;
    callback close();
    callback drag();
    height: 34px;
    background: transparent;
    TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 32px;
        height: parent.height;
        mouse-cursor: default;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.drag();
            }
        }
    }
    Text {
        x: 14px;
        y: 12px;
        height: 17.5px;
        text: title;
        font-size: 13px;
        font-weight: 500;
        color: Tokens.ink1;
        vertical-alignment: center;
    }
    ChromeClose {
        x: parent.width - 32px;
        y: 12px;
        close => { root.close(); }
    }
}
