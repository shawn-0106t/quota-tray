// Shared primitives and the vertical metrics of the panel card.
//
// Every `Metrics` value is a CSS box-model height measured from the shipped
// DOM (spike/slint-demo/ref/rects-*.json) and re-checked by
// `spike/p2/heights_ref.py`: the panes stack blocks with these exact heights,
// and `panel.slint` derives the card height from the same constants, so the
// layout and the number the window is sized to cannot drift apart.
import { Tokens } from "tokens.slint";

export global Metrics {
    // Card chrome, measured from the content box (inside the card's 1px
    // border): header + provider tab end at 87.5; the footer (hairline included)
    // is 53 tall. The card itself is content + 2 borders.
    out property <length> chrome-top: 87.5px;
    out property <length> chrome-bottom: 53px;
    // Transparent shadow fade room per side (PLAN §3.2).
    out property <length> margin: 28px;

    // Kimi pane blocks.
    out property <length> quota-block: 115px;      // .field 105 + .quota margin 10
    out property <length> cache-block: 116px;      // hair 1 + .field 105 + margin 10
    out property <length> decode-row: 56.5px;      // 1 + 9 + 17.5 + 6 + 14 + 9
    out property <length> extra-row: 36.5px;       // 1 + 9 + 17.5 + 9
    out property <length> extra-monthly: 33px;     // .extra-meta bar margin 9 + bar 4 + note 6 + 14
    out property <length> version-row: 37.5px;     // 1 + 9 + 17.5 + 10 (last-child pad)

    // DeepSeek pane blocks.
    out property <length> balance-block: 64.5px;   // 2 + 15 + 6 + 31.5 + 10
    out property <length> balance-detail: 21px;    // note margin 7 + 14
    out property <length> model-row: 71px;         // 9 + 20 + 8 + 3 + 7 + 14 + 9 + hair
    out property <length> last-model-row: 70px;    // last row draws no bottom hairline
    out property <length> summary-row: 33px;       // 1 + 8 + 14 + 10
    out property <length> hint-row: 37.5px;        // 1 + 10 + 16.5 + 10 (single line)
}

// A Text with a fixed CSS line box. Chrome lays `line-height: normal` out as an
// integer box (13px -> 17px, 12.5px -> 16px, ...) and centres the font's content
// box inside it (half-leading, negative for the 30px/1.05 number). Centring the
// glyphs in the same box reproduces that, including the negative case.
export component Txt inherits Text {
    in property <length> box: 17px;
    height: box;
    vertical-alignment: center;
    wrap: no-wrap;
    overflow: elide;
}

// 10/500, uppercase, .08em tracking — .label in theme.css
export component Lbl inherits Txt {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.8px;
    color: Tokens.ink2;
    box: 12px;
}

// 10.5/400 ink-2 — .note
export component Note inherits Txt {
    font-size: 10.5px;
    color: Tokens.ink2;
    box: 14px;
}

// Wrapping hint (.hint, 11/400, line-height 1.5). Kept apart from `Txt`, which
// is single-line and elides.
export component HintText inherits Text {
    font-size: 11px;
    // CSS line-height 1.5 = 16.5px. Slint has no line-height, so the one-line
    // box is explicit and the glyphs are centred in it.
    height: 16.5px;
    vertical-alignment: center;
    wrap: word-wrap;
    color: Tokens.ink2;
}

// 4px capsule track + fill — .bar
export component Bar inherits Rectangle {
    in property <float> pct: 0;
    in property <length> bar-height: 4px;
    height: bar-height;
    border-radius: 2px;
    background: Tokens.hair-soft;
    Rectangle {
        // Slint centres an un-positioned child in its parent; CSS anchors the
        // fill at the track's left edge.
        x: 0;
        y: 0;
        width: parent.width * min(1, pct / 100);
        height: 100%;
        border-radius: parent.border-radius;
        background: Tokens.accent-bar;
    }
}

// One cell of the shared .seg control: 30 high, radius 8, accent ring when on.
export component SegCell inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    border-radius: 8px;
    background: on ? Tokens.seg-on : transparent;
    border-width: on ? 1px : 0px;
    border-color: Tokens.seg-ring;
    Text {
        width: 100%;
        height: 100%;
        text: label;
        font-size: 12.5px;
        font-weight: on ? 500 : 400;
        color: on ? Tokens.ink1 : Tokens.ink2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 1px hairline drawn at a block's top edge.
export component Hair inherits Rectangle {
    height: 1px;
    background: Tokens.hair;
}
