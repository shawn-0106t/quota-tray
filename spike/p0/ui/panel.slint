// P0 panel: the pixel-verified demo layout, restructured into the real
// card/panes/footer model so the tab switch can animate.
//
//   card = header + tab (CHROME-TOP) + panes cell + footer (CHROME-BOTTOM)
//   window = card + 28px transparent shadow room on every side
//
// The card is anchored to the WINDOW's bottom edge (`win-h` is pushed in by
// Rust on every resize), so a switch that pre-sizes the window to the taller
// tab opens room ABOVE the card and the visible bottom edge never moves.
//
// Motion values come from src/main.ts MOTION (PLAN §3.6):
//   grow 200ms  cubic-bezier(0,0,0,1)   shrink 167ms cubic-bezier(1,0,1,1)
//   fade in/out 167ms, outgoing on the exit curve, incoming on the entrance one
import { Tokens } from "tokens.slint";
import { Txt, Lbl, Note, Bar, SegCell } from "primitives.slint";

// Footer ghost action: 16px icon over a 10.5/500 label, centred.
component Act inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    background: transparent;
    border-radius: 8px;
    Path {
        x: (parent.width - 16px) / 2;
        y: 4.5px;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: icon;
        fill: Tokens.ink2;
    }
    Text {
        x: 0;
        y: 23.5px;
        width: parent.width;
        height: 14px;
        text: label;
        font-size: 10.5px;
        font-weight: 500;
        color: Tokens.ink2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export struct ModelRow {
    name: string,
    cost: string,
    share: float,      // 0..1 of the group max, drawn as the token share bar
    tokens: string,    // "665.8M"
    hit: string,       // "cache 99.6%" / "cache --"
    hit-bad: bool,
    today: string,     // "today ¥4.53"
}

// Invisible hit target over one footer action.
component ActionHit inherits TouchArea {
    in property <string> name;
    width: 87.5px;
    height: 42px;
    callback activate(string);
    clicked => {
        activate(name);
    }
}

export component Panel inherits Window {
    in property <bool> dark: false;
    // The header stamp belongs to the provider on screen: it flips with the
    // panes (at animation start), not with the radio.
    in property <string> stamp-kimi: "Updated 16:42";
    in property <string> stamp-ds: "Updated 16:31";

    in property <int> week: 12;
    in property <int> five: 31;
    in property <string> week-reset: "Resets in 2d 18h";
    in property <string> five-reset: "Resets in 3h 33m";
    in property <string> cache-week: "99.5";
    in property <float> cache-week-pct: 99.5;
    in property <string> cache-week-note: "3,169 requests";
    in property <string> cache-today: "99.7";
    in property <float> cache-today-pct: 99.7;
    in property <string> cache-today-note: "807 requests";
    in property <string> speed-value: "135.8 tok/s";
    in property <string> speed-note: "First token 1.04 s · 3,166 calls";
    in property <string> extra-balance: "No data";
    in property <string> cli-version: "0.39.1";

    in property <string> ds-status: "Available";
    in property <string> ds-total: "¥45.44";
    in property <string> ds-detail: "Granted ¥0.00 · Topped up ¥45.44";
    in property <[ModelRow]> models: [];
    in property <string> ds-sum: "This month ¥44.40 · 897M tok";
    in property <string> ds-sum-today: "today ¥6.85";

    // ---- motion state, driven from Rust ----
    // The active tab. Flipped by Rust AFTER the window has been pre-sized: the
    // state transition it starts is the first animated frame.
    in-out property <bool> tab-ds: false;
    // Which pane is on top while it fades out (1 = Kimi, 2 = DeepSeek, 0 = no
    // switch running). The outgoing pane has to stay above the incoming one, or
    // the card background bleeds through the sum of the two fades.
    in-out property <int> outgoing: 0;
    // Show/hide animation state (SPEC 15.1 / 15.2).
    in-out property <bool> shown: false;

    // Window height pushed in by Rust (logical px). The card's y is derived
    // from it so the bottom edge is physically anchored.
    in property <length> win-h: 560px;

    // Cell geometry, measured from the HTML reference (card-relative):
    // header + tab end at 88.5; the footer hairline sits at cell bottom; the
    // card ends 54 below it. Kimi cell 361.5, DeepSeek cell 402.5 (+41 = the
    // 560/601 window height pair).
    private property <length> chrome-top: 88.5px;
    private property <length> chrome-bottom: 54px;
    private property <length> cell-kimi: 361.5px;
    private property <length> cell-ds: 402.5px;

    in-out property <length> cell-h: 361.5px;
    private property <length> card-h: chrome-top + cell-h + chrome-bottom;
    // Window heights the backend sizes to; the +56 is the 2x28 shadow room.
    out property <length> natural-kimi: chrome-top + cell-kimi + chrome-bottom + 56px;
    out property <length> natural-ds: chrome-top + cell-ds + chrome-bottom + 56px;

    in-out property <float> fade-kimi: 1;
    in-out property <float> fade-ds: 0;
    // #root in main.css: opacity 0 + translateY(16px) when hidden.
    in-out property <float> body-opacity: 0;
    in-out property <length> body-lift: 16px;

    callback request-tab(bool);
    callback action(string);

    width: 424px;
    height: 560px;
    no-frame: true;
    background: transparent;
    default-font-family: "Segoe UI";
    default-font-size: 12px;

    states [
        // Slint states are EXCLUSIVE: the first matching state owns every
        // property it assigns, so tab and visibility cannot be two independent
        // dimensions. Four combined states carry both.
        kimi-shown when !tab-ds && shown: {
            cell-h: cell-kimi;
            fade-kimi: 1;
            fade-ds: 0;
            body-opacity: 1;
            body-lift: 0px;
            in {
                animate cell-h { duration: 167ms; easing: cubic-bezier(1.0, 0.0, 1.0, 1.0); }
                animate fade-kimi { duration: 167ms; easing: cubic-bezier(0.0, 0.0, 0.0, 1.0); }
                animate fade-ds { duration: 167ms; easing: cubic-bezier(1.0, 0.0, 1.0, 1.0); }
                animate body-opacity { duration: 160ms; easing: linear; }
                animate body-lift { duration: 220ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1.0); }
            }
        }
        ds-shown when tab-ds && shown: {
            cell-h: cell-ds;
            fade-kimi: 0;
            fade-ds: 1;
            body-opacity: 1;
            body-lift: 0px;
            in {
                animate cell-h { duration: 200ms; easing: cubic-bezier(0.0, 0.0, 0.0, 1.0); }
                animate fade-kimi { duration: 167ms; easing: cubic-bezier(1.0, 0.0, 1.0, 1.0); }
                animate fade-ds { duration: 167ms; easing: cubic-bezier(0.0, 0.0, 0.0, 1.0); }
                animate body-opacity { duration: 160ms; easing: linear; }
                animate body-lift { duration: 220ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1.0); }
            }
        }
        kimi-hidden when !tab-ds && !shown: {
            cell-h: cell-kimi;
            fade-kimi: 1;
            fade-ds: 0;
            body-opacity: 0;
            body-lift: 12px;
            in {
                animate cell-h { duration: 167ms; easing: cubic-bezier(1.0, 0.0, 1.0, 1.0); }
                animate fade-kimi { duration: 167ms; easing: cubic-bezier(0.0, 0.0, 0.0, 1.0); }
                animate fade-ds { duration: 167ms; easing: cubic-bezier(1.0, 0.0, 1.0, 1.0); }
                animate body-opacity { duration: 130ms; easing: linear; }
                animate body-lift { duration: 160ms; easing: cubic-bezier(0.55, 0.055, 0.675, 0.19); }
            }
        }
        ds-hidden when tab-ds && !shown: {
            cell-h: cell-ds;
            fade-kimi: 0;
            fade-ds: 1;
            body-opacity: 0;
            body-lift: 12px;
            in {
                animate cell-h { duration: 200ms; easing: cubic-bezier(0.0, 0.0, 0.0, 1.0); }
                animate fade-kimi { duration: 167ms; easing: cubic-bezier(1.0, 0.0, 1.0, 1.0); }
                animate fade-ds { duration: 167ms; easing: cubic-bezier(0.0, 0.0, 0.0, 1.0); }
                animate body-opacity { duration: 130ms; easing: linear; }
                animate body-lift { duration: 160ms; easing: cubic-bezier(0.55, 0.055, 0.675, 0.19); }
            }
        }
    ]

    body := Rectangle {
        x: 0;
        y: body-lift;
        width: 100%;
        height: 100%;
        opacity: body-opacity;
        background: transparent;

        card := Rectangle {
            x: 28px;
            // Bottom-anchored: the extra room of a pre-sized window opens above.
            y: win-h - 28px - card-h;
            width: 368px;
            height: card-h;
            background: Tokens.paper;
            border-width: 1px;
            border-color: Tokens.hair;
            border-radius: 12px;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 8px;
            drop-shadow-blur: 18px;
            drop-shadow-spread: 0px;
            drop-shadow-color: Tokens.shadow;

            // ---- header ----
            Txt {
                x: 15px;
                y: 13px;
                text: "Quota Tray";
                font-size: 13px;
                font-weight: 500;
                color: Tokens.ink1;
                box: 17px;
            }
            Txt {
                x: 15px;
                y: 15px;
                width: 338px;
                text: tab-ds ? stamp-ds : stamp-kimi;
                font-size: 11px;
                color: Tokens.ink2;
                box: 15px;
                horizontal-alignment: right;
            }

            // ---- provider tab ----
            Rectangle {
                x: 15px;
                y: 40.5px;
                width: 338px;
                height: 36px;
                background: Tokens.seg-track;
                border-radius: 12px;
            }
            SegCell {
                x: 18px;
                y: 43.5px;
                width: 165px;
                height: 30px;
                label: "Kimi";
                on: !tab-ds;
            }
            SegCell {
                x: 185px;
                y: 43.5px;
                width: 165px;
                height: 30px;
                label: "DeepSeek";
                on: tab-ds;
            }
            TouchArea {
                x: 15px;
                y: 40.5px;
                width: 338px;
                height: 36px;
                clicked => {
                    request-tab(self.mouse-x > 169px);
                }
            }

            // ---- panes cell ----
            // Clips like `.panes { overflow: hidden }`: while the cell shrinks,
            // the outgoing content is cut at the moving bottom edge.
            cell := Rectangle {
                x: 0;
                y: chrome-top;
                width: 100%;
                height: cell-h;
                clip: true;
                background: transparent;

                // ---- Kimi pane (cell-relative y = demo y - 88.5) ----
                kimi-pane := Rectangle {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: cell-kimi;
                    background: transparent;
                    opacity: fade-kimi;
                    z: (outgoing == 1) ? 1.0 : 0.0;

                    Lbl { x: 15px; y: 10px; text: "WEEKLY"; }
                    nw := Txt {
                        x: 15px;
                        y: 28px;
                        text: week;
                        font-size: 30px;
                        font-weight: 600;
                        letter-spacing: -0.3px;
                        color: Tokens.ink1;
                        box: 31.5px;
                    }
                    Txt {
                        x: nw.x + nw.width + 2px;
                        y: 39px;
                        text: "%";
                        font-size: 15px;
                        font-weight: 500;
                        color: Tokens.ink2;
                        box: 20px;
                    }
                    Bar { x: 15px; y: 69px; width: 157px; pct: week; }
                    Note { x: 15px; y: 80px; text: week-reset; }

                    Lbl { x: 196px; y: 10px; text: "5-HOUR"; }
                    nf := Txt {
                        x: 196px;
                        y: 28px;
                        text: five;
                        font-size: 30px;
                        font-weight: 600;
                        letter-spacing: -0.3px;
                        color: Tokens.ink1;
                        box: 31.5px;
                    }
                    Txt {
                        x: nf.x + nf.width + 2px;
                        y: 39px;
                        text: "%";
                        font-size: 15px;
                        font-weight: 500;
                        color: Tokens.ink2;
                        box: 20px;
                    }
                    Bar { x: 196px; y: 69px; width: 157px; pct: five; }
                    Note { x: 196px; y: 80px; text: five-reset; }

                    Rectangle { x: 15px; y: 115px; width: 338px; height: 1px; background: Tokens.hair; }
                    Lbl { x: 15px; y: 126px; text: "CACHE 7D · LOCAL"; }
                    cw := Txt {
                        x: 15px;
                        y: 144px;
                        text: cache-week;
                        font-size: 30px;
                        font-weight: 600;
                        letter-spacing: -0.3px;
                        color: Tokens.ink1;
                        box: 31.5px;
                    }
                    Txt {
                        x: cw.x + cw.width + 2px;
                        y: 155px;
                        text: "%";
                        font-size: 15px;
                        font-weight: 500;
                        color: Tokens.ink2;
                        box: 20px;
                    }
                    Bar { x: 15px; y: 185px; width: 157px; pct: cache-week-pct; }
                    Note { x: 15px; y: 196px; text: cache-week-note; }

                    Lbl { x: 196px; y: 126px; text: "CACHE TODAY"; }
                    ct := Txt {
                        x: 196px;
                        y: 144px;
                        text: cache-today;
                        font-size: 30px;
                        font-weight: 600;
                        letter-spacing: -0.3px;
                        color: Tokens.ink1;
                        box: 31.5px;
                    }
                    Txt {
                        x: ct.x + ct.width + 2px;
                        y: 155px;
                        text: "%";
                        font-size: 15px;
                        font-weight: 500;
                        color: Tokens.ink2;
                        box: 20px;
                    }
                    Bar { x: 196px; y: 185px; width: 157px; pct: cache-today-pct; }
                    Note { x: 196px; y: 196px; text: cache-today-note; }

                    Rectangle { x: 15px; y: 231px; width: 338px; height: 1px; background: Tokens.hair; }
                    Txt {
                        x: 15px;
                        y: 242px;
                        text: "Decode";
                        font-size: 12px;
                        color: Tokens.ink2;
                        box: 16px;
                    }
                    Txt {
                        x: 15px;
                        y: 241px;
                        width: 338px;
                        text: speed-value;
                        font-size: 13px;
                        font-weight: 500;
                        color: Tokens.ink2;
                        box: 17.5px;
                        horizontal-alignment: right;
                    }
                    Note { x: 15px; y: 264.5px; text: speed-note; }

                    Rectangle { x: 15px; y: 287.5px; width: 338px; height: 1px; background: Tokens.hair; }
                    Txt {
                        x: 15px;
                        y: 298.5px;
                        text: "Extra usage";
                        font-size: 12px;
                        color: Tokens.ink2;
                        box: 16px;
                    }
                    Txt {
                        x: 15px;
                        y: 297.5px;
                        width: 338px;
                        text: extra-balance;
                        font-size: 13px;
                        font-weight: 500;
                        color: Tokens.ink2;
                        box: 17.5px;
                        horizontal-alignment: right;
                    }

                    Rectangle { x: 15px; y: 324px; width: 338px; height: 1px; background: Tokens.hair; }
                    Txt {
                        x: 15px;
                        y: 335px;
                        text: "Kimi Code CLI";
                        font-size: 12px;
                        color: Tokens.ink2;
                        box: 16px;
                    }
                    Rectangle {
                        x: 305.48px;
                        y: 334.1px;
                        width: 47.52px;
                        height: 17.3px;
                        background: Tokens.tint;
                        border-radius: 4px;
                        Text {
                            x: 8px;
                            y: 0;
                            width: 31.52px;
                            height: 17.3px;
                            text: "Update";
                            font-size: 9.5px;
                            font-weight: 500;
                            color: Tokens.accent-ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Txt {
                        x: 15px;
                        y: 334.14px;
                        width: 284.48px;
                        text: cli-version;
                        font-size: 13px;
                        font-weight: 500;
                        color: Tokens.ink2;
                        box: 17px;
                        horizontal-alignment: right;
                    }
                }

                // ---- DeepSeek pane ----
                ds-pane := Rectangle {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: cell-ds;
                    background: transparent;
                    opacity: fade-ds;
                    z: (outgoing == 2) ? 1.0 : 0.0;

                    Lbl { x: 15px; y: 4px; text: "BALANCE"; }
                    Txt {
                        x: 15px;
                        y: 2px;
                        width: 338px;
                        text: ds-status;
                        font-size: 11px;
                        color: Tokens.ink2;
                        box: 15px;
                        horizontal-alignment: right;
                    }
                    Txt {
                        x: 15px;
                        y: 23px;
                        text: ds-total;
                        font-size: 30px;
                        font-weight: 600;
                        letter-spacing: -0.3px;
                        color: Tokens.ink1;
                        box: 31.5px;
                    }
                    Note { x: 15px; y: 61.5px; text: ds-detail; }

                    Rectangle { x: 15px; y: 85.5px; width: 338px; height: 1px; background: Tokens.hair; }
                    for row[i] in models : Rectangle {
                        x: 15px;
                        y: 86.5px + i * 71px;
                        width: 338px;
                        height: 71px;
                        background: transparent;

                        Rectangle {
                            x: 0;
                            y: 70px;
                            width: 338px;
                            height: 1px;
                            background: Tokens.hair;
                            visible: i < models.length - 1;
                        }
                        Txt {
                            x: 0;
                            y: 11.5px;
                            width: 282.73px;
                            text: row.name;
                            font-size: 12.5px;
                            font-weight: 500;
                            color: Tokens.ink1;
                            box: 16.5px;
                        }
                        Txt {
                            x: 0;
                            y: 9px;
                            width: 338px;
                            text: row.cost;
                            font-size: 15px;
                            font-weight: 600;
                            color: Tokens.ink1;
                            box: 20px;
                            horizontal-alignment: right;
                        }
                        Bar { x: 0; y: 37px; width: 338px; bar-height: 3px; pct: row.share * 100; }
                        used := Text {
                            x: 0;
                            y: 47px;
                            text: row.tokens + " tok · ";
                            font-size: 10.5px;
                            color: Tokens.ink2;
                            height: 14px;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }
                        Text {
                            x: used.x + used.width;
                            y: 47px;
                            height: 14px;
                            text: row.hit;
                            font-size: 10.5px;
                            color: row.hit-bad ? Tokens.danger : Tokens.ink2;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }
                        Note {
                            x: 0;
                            y: 47px;
                            width: 338px;
                            text: row.today;
                            horizontal-alignment: right;
                        }
                    }

                    Rectangle { x: 15px; y: 369.5px; width: 338px; height: 1px; background: Tokens.hair; }
                    Note { x: 15px; y: 378.5px; text: ds-sum; }
                    Note {
                        x: 15px;
                        y: 378.5px;
                        width: 338px;
                        text: ds-sum-today;
                        horizontal-alignment: right;
                    }
                }
            }

            // ---- footer ----
            Rectangle {
                x: 1px;
                y: chrome-top + cell-h;
                width: 366px;
                height: 1px;
                background: Tokens.hair;
            }
            Act {
                x: 6px;
                y: chrome-top + cell-h + 6px;
                width: 87.5px;
                height: 42px;
                label: "Console";
                icon: "M12.3994 12.4863C12.396 10.8789 14.2659 9.99419 15.5068 11.0156L21.3887 15.8594C22.6251 16.8787 22.1145 18.8522 20.5918 19.1816L20.4404 19.207L17.6953 19.5889C17.6853 19.5903 17.675 19.5934 17.666 19.5977L17.6416 19.6143L15.6055 21.4961L15.4902 21.5957C14.3092 22.5333 12.5401 21.7604 12.4238 20.2568L12.417 20.1045L12.3994 12.4863ZM14.2568 12.3916C14.2298 12.4044 14.2145 12.4205 14.209 12.4287C14.2068 12.4321 14.2055 12.4358 14.2041 12.4404C14.2028 12.4447 14.1992 12.4578 14.1992 12.4824L14.2168 20.0996L14.2227 20.1445C14.2241 20.149 14.2254 20.1522 14.2275 20.1553C14.2329 20.1629 14.2486 20.1788 14.2773 20.1914C14.3063 20.204 14.329 20.2044 14.3379 20.2031C14.3414 20.2026 14.3446 20.2011 14.3486 20.1992C14.3527 20.1972 14.3649 20.1912 14.3838 20.1738L16.4199 18.292L16.5156 18.2041L16.623 18.1299L16.6475 18.1133L16.7646 18.0342L16.8916 17.9727C17.104 17.8715 17.3 17.827 17.4443 17.8066H17.4473L20.1475 17.4307L20.2217 17.417C20.231 17.4143 20.2373 17.4141 20.2393 17.4131C20.2419 17.4115 20.2448 17.4086 20.248 17.4053C20.2562 17.3968 20.27 17.378 20.2773 17.3486C20.2846 17.3193 20.2817 17.298 20.2793 17.29C20.2783 17.2869 20.2761 17.2833 20.2734 17.2793C20.2707 17.2752 20.2631 17.2637 20.2441 17.248V17.249L14.3623 12.4053C14.3434 12.3898 14.3313 12.3836 14.3271 12.3818C14.323 12.3802 14.3192 12.3793 14.3154 12.3789C14.3054 12.378 14.2834 12.3791 14.2568 12.3916ZM18.6797 2.00488C20.5292 2.09842 22 3.62727 22 5.5L21.9951 13H20.2002V9H3.7998V16C3.7998 16.9389 4.56112 17.7002 5.5 17.7002H11V19.5H5.5L5.32031 19.4951C3.53035 19.4046 2.09541 17.9697 2.00488 16.1797L2 16V5.5C2 3.62727 3.47083 2.09842 5.32031 2.00488L5.5 2H18.5L18.6797 2.00488ZM5.5 3.7998C4.61979 3.7998 3.89565 4.46893 3.80859 5.32617L3.7998 5.5V7.2002H20.2002V5.5C20.2002 4.61979 19.5311 3.89565 18.6738 3.80859L18.5 3.7998H5.5ZM7.3916 4.60449C7.84564 4.65038 8.2002 5.03386 8.2002 5.5C8.2002 5.96614 7.84564 6.34962 7.3916 6.39551L7.2998 6.40039H5.5C5.00294 6.40039 4.59961 5.99706 4.59961 5.5C4.59961 5.00294 5.00294 4.59961 5.5 4.59961H7.2998L7.3916 4.60449Z";
            }
            Act {
                x: 95.5px;
                y: chrome-top + cell-h + 6px;
                width: 87.5px;
