// Quota Tray panel, re-drawn against the HTML reference's own bounding boxes
// (spike/slint-demo/ref/rects-*.json). Every x/y/height below is a measured
// value from `index.html` at 424 px; the card is bottom-anchored like the real
// window, so only the renderer is under test here.
import { Tokens } from "tokens.slint";
import { Txt, Lbl, Note, Bar, SegCell, SegTrack } from "primitives.slint";

// Footer ghost action: 16px icon over a 10.5/500 label, centred.
component Act inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    background: transparent;
    border-radius: 8px;
    Path {
        x: (parent.width - 16px) / 2;
        y: 4.5px;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: icon;
        fill: Tokens.ink2;
    }
    Text {
        x: 0;
        y: 23.5px;
        width: parent.width;
        height: 14px;
        text: label;
        font-size: 10.5px;
        font-weight: 500;
        color: Tokens.ink2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export struct ModelRow {
    name: string,
    cost: string,
    share: float,      // 0..1 of the group max, drawn as the token share bar
    tokens: string,    // "665.8M"
    hit: string,       // "cache 99.6%" / "cache --"
    hit-bad: bool,
    today: string,     // "today ¥4.53"
}

export component Panel inherits Window {
    in property <bool> dark: false;
    in property <bool> stage-visible: true;
    in property <bool> tab-ds: false;

    in property <string> stamp: "Updated 16:42";

    in property <int> week: 12;
    in property <int> five: 31;
    in property <string> week-reset: "Resets in 2d 18h";
    in property <string> five-reset: "Resets in 3h 33m";
    in property <string> cache-week: "99.5";
    in property <float> cache-week-pct: 99.5;
    in property <string> cache-week-note: "3,169 requests";
    in property <string> cache-today: "99.7";
    in property <float> cache-today-pct: 99.7;
    in property <string> cache-today-note: "807 requests";
    in property <string> speed-value: "135.8 tok/s";
    in property <string> speed-note: "First token 1.04 s · 3,166 calls";
    in property <string> extra-balance: "No data";
    in property <string> cli-version: "0.39.1";

    in property <string> ds-status: "Available";
    in property <string> ds-total: "¥45.44";
    in property <string> ds-detail: "Granted ¥0.00 · Topped up ¥45.44";
    in property <[ModelRow]> models: [];
    in property <string> ds-sum: "This month ¥44.40 · 897M tok";
    in property <string> ds-sum-today: "today ¥6.85";

    // Card heights measured from the HTML reference (card = window - 56).
    in property <length> card-height: tab-ds ? 545px : 504px;
    // The footer sits on the card's content bottom: 447.3 / 453.3 on Kimi,
    // 490.5 / 496.5 on DeepSeek (the pane is 43.2 px taller).
    in property <length> footer-hair: tab-ds ? 491px : 450px;
    in property <length> footer-top: tab-ds ? 497px : 456px;
    // Sweepable: CSS box-shadow blur and Slint's drop-shadow blur are not the
    // same unit; the report records the value that matches the DOM reference.
    in property <length> shadow-blur: 42px;

    width: 424px;
    height: tab-ds ? 601px : 560px;
    background: stage-visible ? Tokens.stage : transparent;
    default-font-family: "Segoe UI";
    default-font-size: 12px;

    card := Rectangle {
        x: 28px;
        y: 28px;
        width: 368px;
        height: card-height;
        background: Tokens.paper;
        border-width: 1px;
        border-color: Tokens.hair;
        border-radius: 12px;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 8px;
        drop-shadow-blur: shadow-blur;
        drop-shadow-spread: 0px;
        drop-shadow-color: Tokens.shadow;
    }

    // ---- header: wordmark + stamp, then the provider tab ----
    Txt {
        x: 28px + 15px;
        y: card.y + 13px;
        text: "Quota Tray";
        font-size: 13px;
        font-weight: 500;
        color: Tokens.ink1;
        box: 17px;
    }
    Txt {
        x: 28px + 15px;
        y: card.y + 15px;
        width: 338px;
        text: stamp;
        font-size: 11px;
        color: Tokens.ink2;
        box: 15px;
        horizontal-alignment: right;
    }
    Rectangle {
        x: 28px + 15px;
        y: card.y + 40.5px;
        width: 338px;
        height: 36px;
        background: Tokens.seg-track;
        border-radius: 12px;
    }
    SegCell {
        x: 28px + 18px;
        y: card.y + 43.5px;
        width: 165px;
        height: 30px;
        label: "Kimi";
        on: !tab-ds;
    }
    SegCell {
        x: 28px + 185px;
        y: card.y + 43.5px;
        width: 165px;
        height: 30px;
        label: "DeepSeek";
        on: tab-ds;
    }

    // ---- Kimi pane (local coordinates inside the card) ----
    Rectangle {
        visible: !tab-ds;
        x: 28px;
        y: card.y;
        width: 368px;
        height: 504px;
        background: transparent;

        // quota: two bare readout columns
        Lbl { x: 15px; y: 98.5px; text: "WEEKLY"; }
        nw := Txt {
            x: 15px;
            y: 116.5px;
            text: week;
            font-size: 30px;
            font-weight: 600;
            letter-spacing: -0.3px;
            color: Tokens.ink1;
            box: 31.5px;
        }
        Txt {
            x: nw.x + nw.width + 2px;
            y: 127.5px;
            text: "%";
            font-size: 15px;
            font-weight: 500;
            color: Tokens.ink2;
            box: 20px;
        }
        Bar { x: 15px; y: 157.5px; width: 157px; pct: week; }
        Note { x: 15px; y: 168.5px; text: week-reset; }

        Lbl { x: 196px; y: 98.5px; text: "5-HOUR"; }
        nf := Txt {
            x: 196px;
            y: 116.5px;
            text: five;
            font-size: 30px;
            font-weight: 600;
            letter-spacing: -0.3px;
            color: Tokens.ink1;
            box: 31.5px;
        }
        Txt {
            x: nf.x + nf.width + 2px;
            y: 127.5px;
            text: "%";
            font-size: 15px;
            font-weight: 500;
            color: Tokens.ink2;
            box: 20px;
        }
        Bar { x: 196px; y: 157.5px; width: 157px; pct: five; }
        Note { x: 196px; y: 168.5px; text: five-reset; }

        // cache / decode block (PLAN section 5.1), separated by the row hairline
        Rectangle { x: 15px; y: 203.5px; width: 338px; height: 1px; background: Tokens.hair; }
        Lbl { x: 15px; y: 214.5px; text: "CACHE 7D · LOCAL"; }
        cw := Txt {
            x: 15px;
            y: 232.5px;
            text: cache-week;
            font-size: 30px;
            font-weight: 600;
            letter-spacing: -0.3px;
            color: Tokens.ink1;
            box: 31.5px;
        }
        Txt {
            x: cw.x + cw.width + 2px;
            y: 243.5px;
            text: "%";
            font-size: 15px;
            font-weight: 500;
            color: Tokens.ink2;
            box: 20px;
        }
        Bar { x: 15px; y: 273.5px; width: 157px; pct: cache-week-pct; }
        Note { x: 15px; y: 284.5px; text: cache-week-note; }

        Lbl { x: 196px; y: 214.5px; text: "CACHE TODAY"; }
        ct := Txt {
            x: 196px;
            y: 232.5px;
            text: cache-today;
            font-size: 30px;
            font-weight: 600;
            letter-spacing: -0.3px;
            color: Tokens.ink1;
            box: 31.5px;
        }
        Txt {
            x: ct.x + ct.width + 2px;
            y: 243.5px;
            text: "%";
            font-size: 15px;
            font-weight: 500;
            color: Tokens.ink2;
            box: 20px;
        }
        Bar { x: 196px; y: 273.5px; width: 157px; pct: cache-today-pct; }
        Note { x: 196px; y: 284.5px; text: cache-today-note; }

        // decode row
        Rectangle { x: 15px; y: 319.5px; width: 338px; height: 1px; background: Tokens.hair; }
        Txt {
            x: 15px;
            y: 330.5px;
            text: "Decode";
            font-size: 12px;
            color: Tokens.ink2;
            box: 16px;
        }
        Txt {
            x: 15px;
            y: 329.5px;
            width: 338px;
            text: speed-value;
            font-size: 13px;
            font-weight: 500;
            color: Tokens.ink2;
            box: 17.5px;
            horizontal-alignment: right;
        }
        Note { x: 15px; y: 353px; text: speed-note; }

        // extra usage row
        Rectangle { x: 15px; y: 376px; width: 338px; height: 1px; background: Tokens.hair; }
        Txt {
            x: 15px;
            y: 387px;
            text: "Extra usage";
            font-size: 12px;
            color: Tokens.ink2;
            box: 16px;
        }
        Txt {
            x: 15px;
            y: 386px;
            width: 338px;
            text: extra-balance;
            font-size: 13px;
            font-weight: 500;
            color: Tokens.ink2;
            box: 17.5px;
            horizontal-alignment: right;
        }

        // CLI version row
        Rectangle { x: 15px; y: 412.5px; width: 338px; height: 1px; background: Tokens.hair; }
        Txt {
            x: 15px;
            y: 423.5px;
            text: "Kimi Code CLI";
            font-size: 12px;
            color: Tokens.ink2;
            box: 16px;
        }
        Rectangle {
            x: 305.48px;
            y: 422.6px;
            width: 47.52px;
            height: 17.3px;
            background: Tokens.tint;
            border-radius: 4px;
            Text {
                x: 8px;
                y: 0;
                width: 31.52px;
                height: 17.3px;
                text: "Update";
                font-size: 9.5px;
                font-weight: 500;
                color: Tokens.accent-ink;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Txt {
            x: 15px;
            y: 422.64px;
            width: 284.48px;
            text: cli-version;
            font-size: 13px;
            font-weight: 500;
            color: Tokens.ink2;
            box: 17px;
            horizontal-alignment: right;
        }
    }

    // ---- DeepSeek pane ----
    Rectangle {
        visible: tab-ds;
        x: 28px;
        y: card.y;
        width: 368px;
        height: 545px;
        background: transparent;

        Lbl { x: 15px; y: 92.5px; text: "BALANCE"; }
        Txt {
            x: 15px;
            y: 90.5px;
            width: 338px;
            text: ds-status;
            font-size: 11px;
            color: Tokens.ink2;
            box: 15px;
            horizontal-alignment: right;
        }
        Txt {
            x: 15px;
            y: 111.5px;
            text: ds-total;
            font-size: 30px;
            font-weight: 600;
            letter-spacing: -0.3px;
            color: Tokens.ink1;
            box: 31.5px;
        }
        Note { x: 15px; y: 150px; text: ds-detail; }

        // model rows: hairline top, 71px per row, token-share bar
        Rectangle { x: 15px; y: 174px; width: 338px; height: 1px; background: Tokens.hair; }
        for row[i] in models : Rectangle {
            x: 15px;
            y: 175px + i * 71px;
            width: 338px;
            height: 71px;
            background: transparent;

            Rectangle {
                x: 0;
                y: 70px;
                width: 338px;
                height: 1px;
                background: Tokens.hair;
                visible: i < models.length - 1;
            }
            Txt {
                x: 0;
                y: 11.5px;
                width: 282.73px;
                text: row.name;
                font-size: 12.5px;
                font-weight: 500;
                color: Tokens.ink1;
                box: 16.5px;
            }
            Txt {
                x: 0;
                y: 9px;
                width: 338px;
                text: row.cost;
                font-size: 15px;
                font-weight: 600;
                color: Tokens.ink1;
                box: 20px;
                horizontal-alignment: right;
            }
            Bar { x: 0; y: 37px; width: 338px; bar-height: 3px; pct: row.share * 100; }
            used := Text {
                x: 0;
                y: 47px;
                text: row.tokens + " tok · ";
                font-size: 10.5px;
                color: Tokens.ink2;
                height: 14px;
                vertical-alignment: center;
                wrap: no-wrap;
            }
            Text {
                x: used.x + used.width;
                y: 47px;
                height: 14px;
                text: row.hit;
                font-size: 10.5px;
                color: row.hit-bad ? Tokens.danger : Tokens.ink2;
                vertical-alignment: center;
                wrap: no-wrap;
            }
            Note {
                x: 0;
                y: 47px;
                width: 338px;
                text: row.today;
                horizontal-alignment: right;
            }
        }

        // month total
        Rectangle { x: 15px; y: 458px; width: 338px; height: 1px; background: Tokens.hair; }
        Note { x: 15px; y: 467px; text: ds-sum; }
        Note {
            x: 15px;
            y: 467px;
            width: 338px;
            text: ds-sum-today;
            horizontal-alignment: right;
        }
    }

    // ---- footer: four ghost actions ----
    Rectangle { x: 29px; y: card.y + footer-hair; width: 366px; height: 1px; background: Tokens.hair; }
    Act {
        x: 28px + 6px;
        y: card.y + footer-top;
        width: 87.5px;
        height: 42px;
        label: "Console";
        icon: "M12.3994 12.4863C12.396 10.8789 14.2659 9.99419 15.5068 11.0156L21.3887 15.8594C22.6251 16.8787 22.1145 18.8522 20.5918 19.1816L20.4404 19.207L17.6953 19.5889C17.6853 19.5903 17.675 19.5934 17.666 19.5977L17.6416 19.6143L15.6055 21.4961L15.4902 21.5957C14.3092 22.5333 12.5401 21.7604 12.4238 20.2568L12.417 20.1045L12.3994 12.4863ZM14.2568 12.3916C14.2298 12.4044 14.2145 12.4205 14.209 12.4287C14.2068 12.4321 14.2055 12.4358 14.2041 12.4404C14.2028 12.4447 14.1992 12.4578 14.1992 12.4824L14.2168 20.0996L14.2227 20.1445C14.2241 20.149 14.2254 20.1522 14.2275 20.1553C14.2329 20.1629 14.2486 20.1788 14.2773 20.1914C14.3063 20.204 14.329 20.2044 14.3379 20.2031C14.3414 20.2026 14.3446 20.2011 14.3486 20.1992C14.3527 20.1972 14.3649 20.1912 14.3838 20.1738L16.4199 18.292L16.5156 18.2041L16.623 18.1299L16.6475 18.1133L16.7646 18.0342L16.8916 17.9727C17.104 17.8715 17.3 17.827 17.4443 17.8066H17.4473L20.1475 17.4307L20.2217 17.417C20.231 17.4143 20.2373 17.4141 20.2393 17.4131C20.2419 17.4115 20.2448 17.4086 20.248 17.4053C20.2562 17.3968 20.27 17.378 20.2773 17.3486C20.2846 17.3193 20.2817 17.298 20.2793 17.29C20.2783 17.2869 20.2761 17.2833 20.2734 17.2793C20.2707 17.2752 20.2631 17.2637 20.2441 17.248V17.249L14.3623 12.4053C14.3434 12.3898 14.3313 12.3836 14.3271 12.3818C14.323 12.3802 14.3192 12.3793 14.3154 12.3789C14.3054 12.378 14.2834 12.3791 14.2568 12.3916ZM18.6797 2.00488C20.5292 2.09842 22 3.62727 22 5.5L21.9951 13H20.2002V9H3.7998V16C3.7998 16.9389 4.56112 17.7002 5.5 17.7002H11V19.5H5.5L5.32031 19.4951C3.53035 19.4046 2.09541 17.9697 2.00488 16.1797L2 16V5.5C2 3.62727 3.47083 2.09842 5.32031 2.00488L5.5 2H18.5L18.6797 2.00488ZM5.5 3.7998C4.61979 3.7998 3.89565 4.46893 3.80859 5.32617L3.7998 5.5V7.2002H20.2002V5.5C20.2002 4.61979 19.5311 3.89565 18.6738 3.80859L18.5 3.7998H5.5ZM7.3916 4.60449C7.84564 4.65038 8.2002 5.03386 8.2002 5.5C8.2002 5.96614 7.84564 6.34962 7.3916 6.39551L7.2998 6.40039H5.5C5.00294 6.40039 4.59961 5.99706 4.59961 5.5C4.59961 5.00294 5.00294 4.59961 5.5 4.59961H7.2998L7.3916 4.60449Z";
    }
    Act {
        x: 28px + 95.5px;
        y: card.y + footer-top;
        width: 87.5px;
        height: 42px;
        label: "Refresh";
        icon: "M6.88048 6.89231C9.69226 4.08054 14.251 4.08054 17.0628 6.89231L16.2364 7.71871C15.7324 8.22268 16.0894 9.0844 16.8021 9.0844H19.7276C20.1694 9.0844 20.5276 8.72623 20.5276 8.2844V5.35891C20.5276 4.64619 19.6659 4.28926 19.1619 4.79323L18.3356 5.61952C14.8209 2.1048 9.12241 2.1048 5.60769 5.61952C2.09297 9.13424 2.09297 14.8327 5.60769 18.3474C9.12241 21.8622 14.8209 21.8622 18.3356 18.3474C19.4929 17.1902 20.2703 15.7937 20.6655 14.3163C20.7939 13.8361 20.5087 13.3428 20.0285 13.2143C19.5483 13.0859 19.055 13.3711 18.9266 13.8513C18.611 15.0314 17.9906 16.1469 17.0628 17.0746C14.251 19.8864 9.69226 19.8864 6.88048 17.0746C4.06871 14.2629 4.06871 9.70409 6.88048 6.89231Z";
    }
    Act {
        x: 28px + 185px;
        y: card.y + footer-top;
        width: 87.5px;
        height: 42px;
